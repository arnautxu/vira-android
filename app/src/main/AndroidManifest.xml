<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- El compte i la sincronització (`core/backend`). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Concentra't (`features/focus`): l'avís fix amb el cronòmetre, i l'alarma del final. Els
         avisos i les alarmes exactes també els fan servir les notificacions (`core/notifications`). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Notificacions (`core/notifications`): Android esborra les alarmes en apagar el telèfon. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Ajuda ara (`features/help`): la vibració que marca la respiració. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Avui (`features/today`): llegeix el calendari del sistema, només si l'interruptor és encès. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Afegir (`features/add`): dir una tasca amb el micròfon. El reconeixement és només al
         telèfon (`TaskDictation`) i cap àudio es desa; el permís es demana en tocar el micròfon. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- El servei de reconeixement de veu del telèfon, perquè Android 11+ el deixi veure. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".ViraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vira">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Tornada del navegador després d'entrar amb Google o Apple, i enllaç del correu. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vira" android:host="auth-callback" />
            </intent-filter>
            <!-- Codi de vinculació del panell de pares (`ViraUniversalLink`): omple el camp, mai
                 l'envia. L'enllaç web és el que s'envia; l'esquema propi, el de reserva. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="vira.cat" android:pathPrefix="/link/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vira" android:host="link" />
            </intent-filter>
        </activity>

        <!-- Concentra't: el servei en primer pla que substitueix la Live Activity de l'iPhone. -->
        <service
            android:name=".features.focus.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_timer" />
        </service>
        <receiver
            android:name=".features.focus.FocusAlarmReceiver"
            android:exported="false" />

        <!-- Notificacions: l'alarma que publica l'avís, els botons de dins i el que les torna a posar
             després d'apagar el telèfon, d'una actualització o d'un canvi d'hora o de zona. -->
        <receiver
            android:name=".core.notifications.ViraNotificationAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".core.notifications.ViraNotificationActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".core.notifications.ViraNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
