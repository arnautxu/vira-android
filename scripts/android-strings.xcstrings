    },
    "tutorial.emotions.message": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra com et sents i mira com ha anat la setmana."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log how you feel and see how the week went."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra cómo te sientes y mira cómo ha ido la semana."
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "tutorial.plan.message": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendari, hàbits i medicació. Tot el que té una hora és aquí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar, habits and medication. Everything with a time lives here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario, hábitos y medicación. Todo lo que tiene una hora está aquí."
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "tutorial.plan.title": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu pla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan"
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "tutorial.profile.message": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La ratxa, els premis i la botiga. Res es perd pel camí."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your streak, rewards and shop. Nothing gets lost along the way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La racha, los premios y la tienda. No se pierde nada por el camino."
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "tutorial.widgets.how": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premuda la pantalla d'inici o la de bloqueig, toca Edita i busca Vira."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold the Home Screen or Lock Screen, tap Edit and look for Vira."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la pantalla de inicio o la de bloqueo, toca Editar y busca Vira."
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "tutorial.widgets.message": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El pla del dia i la ratxa, a la pantalla d'inici. Pots marcar una tasca sense obrir l'app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your day's plan and your streak, right on the Home Screen. You can tick a task without opening the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan del día y la racha, en la pantalla de inicio. Puedes marcar una tarea sin abrir la app."
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    }
  }
}