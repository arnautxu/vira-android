          "stringUnit": {
            "state": "translated",
            "value": "Vull començar a"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want to start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
