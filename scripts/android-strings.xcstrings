{
  "sourceLanguage": "ca",
  "version": "1.0",
  "strings": {
    "habits.reminder.denied": {
      "comment": "Android: l'iPhone diu «Ajustos d'iOS».",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els avisos estan desactivats als ajustos del telèfon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos están desactivados en los ajustes del teléfono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off in your phone's settings."
          }
        }
      }
    },
    "settings.privacy.lock": {
      "comment": "Android: l'iPhone diu «Face ID».",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueig amb empremta, cara o codi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueo con huella, cara o código"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock with fingerprint, face or PIN"
          }
        }
      }
    },
    "settings.privacy.lock.unavailable": {
      "comment": "Android: l'iPhone diu «Face ID».",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa l'empremta, la cara o un codi al telèfon per fer-ho servir"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la huella, la cara o un código en el teléfono para usarlo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on fingerprint, face or a screen lock on this phone to use it"
          }
        }
      }
    },
    "settings.search.empty": {
      "comment": "Android: l'iPhone fa servir el buit de cerca del sistema.",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap ajust amb aquestes paraules"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún ajuste con estas palabras"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No settings match these words"
          }
        }
      }
    },
    "tutorial.integrations.title": {
      "comment": "Android: l'iPhone diu «iPhone».",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vira al teu mòbil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vira en tu móvil"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vira on your phone"
          }
        }
      }
    },
    "tutorial.integrations.outside": {
      "comment": "Android: l'iPhone parla de Siri i de la cerca, que Android no té.",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "També pots afegir Vira a la pantalla d'inici i als botons del panell ràpid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes añadir Vira a la pantalla de inicio y a los botones del panel rápido."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also add Vira to your home screen and to the quick settings tiles."
          }
        }
      }
    },
    "plan.reorder.moveUp": {
      "comment": "Android: acció de TalkBack per reordenar; a l'iPhone ho fa el sistema.",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou amunt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move up"
          }
        }
      }
    },
    "plan.reorder.moveDown": {
      "comment": "Android: acció de TalkBack per reordenar; a l'iPhone ho fa el sistema.",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou avall"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move down"
          }
        }
      }
    },
    "settings.motivation.streak_live.hint": {
      "comment": "Android: l'iPhone diu «Dynamic Island»; aquí és un avís fix.",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Surt com a avís fix quan queda una hora i el dia encara no compta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale como aviso fijo cuando queda una hora y el día aún no cuenta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows up as a pinned notification when an hour is left and the day doesn't count yet."
          }
        }
      }
    },
    "shop.cards.bought.subtitle": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Al teu perfil"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your profile"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu perfil"
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "shop.cards.bought.title": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per comprar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To buy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para comprar"
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
