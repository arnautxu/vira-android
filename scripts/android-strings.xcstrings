    },
    "shop.cards.earned.done": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Guanyada"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earned"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganada"
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "shop.cards.earned.title": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les guanyes fent"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earned by doing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ganas haciendo"
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "shop.cards.progress": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@/%2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@/%2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@/%2$@"
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "shop.section.badges": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartes"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartas"
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "shop.section.skins": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Skins"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skins"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Skins"
          }
        }
      },
      "comment": "Temporal (2026-10-23): l'iPhone ja no el fa servir (PR #39–#45). Es treu quan la pantalla d'Android que el llegeix (entrada, tomb o Botiga) passi a la versió nova."
    },
    "notification.permission.denied": {
      "comment": "Android: l'iPhone diu «Ajustos de l'iPhone».",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els avisos estan apagats. Es tornen a encendre als ajustos del telèfon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos están apagados. Se vuelven a encender en los ajustes del teléfono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. You can turn them back on in your phone's settings."
          }
        }
      }
    },
    "notification.permission.ask.general.support": {
      "comment": "Android: l'iPhone diu «L'iPhone».",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El telèfon necessita el teu permís."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono necesita tu permiso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone needs your OK."
          }
        }
      }
    }
  }
}
